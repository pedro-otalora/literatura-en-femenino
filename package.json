{
  "name": "pec2-jornadas-literarias",
  "version": "1.0.0",
  "private": true,
  "description": "PEC2 Herramientas HTML y CSS II (UOC): web de unas jornadas literarias con Bootstrap",
  "scripts": {
    "parcel:serve": "parcel -p 8123 --target web",
    "parcel:build": "parcel build --target web --no-source-maps --no-cache",
    "clean": "rimraf dist .cache .cache-loader .parcel-cache",
    "dev": "npm-run-all clean parcel:serve",
    "stylelint": "stylelint \"src/**/*.scss\"",
    "stylelint:fix": "stylelint \"src/**/*.scss\" --fix",
    "build": "npm-run-all clean stylelint parcel:build",
    "test": "echo 'Everything is working as expected ✅\nStart working on your project by running \\033[1mnpm run dev\\033[0m'"
  },
  "targets": {
    "web": {
      "context": "browser",
      "publicUrl": "./",
      "source": [
        "src/index.html",
        "src/ponentes.html",
        "src/articulo.html",
        "src/programa.html"
      ],
      "engines": {
        "browsers": "last 2 versions, > 0.5%, not dead"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedro-otalora/pec2-jornadas-literarias.git"
  },
  "author": {
    "name": "Pedro Otálora Giménez",
    "email": "pedrootalora@uoc.edu"
  },
  "license": "MIT",
  "devDependencies": {
    "@parcel/transformer-sass": "^2.16.4",
    "autoprefixer": "^10.5.5",
    "npm-run-all": "^4.1.5",
    "parcel": "^2.16.4",
    "postcss-preset-env": "^11.5.1",
    "posthtml-include": "^2.0.1",
    "rimraf": "^6.1.3",
    "sharp": "^0.33.5",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.10.0",
    "stylelint-config-standard-scss": "^17.0.0"
  }
}
